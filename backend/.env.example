# Spring Boot backend — copy to .env locally, NEVER commit real secrets
# PostgreSQL 15 (Railway in prod, local Postgres or H2 dev)
PORT=8080
SPRING_PROFILES_ACTIVE=prod
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_delivery
DB_USER=fooduser
DB_PASSWORD=change-me
JWT_SECRET=change-this-to-a-long-random-256bit-secret-min-32-chars
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_OTP_DEV_MODE=true
