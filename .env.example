# Root env template — copy to .env locally, NEVER commit real .env
# Backend (Spring Boot, PostgreSQL 15 on Railway, Render hosting)
PORT=8080
SPRING_PROFILES_ACTIVE=prod
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_delivery
DB_USER=fooduser
DB_PASSWORD=change-me
JWT_SECRET=change-this-to-a-long-random-256bit-secret-min-32-chars
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_OTP_DEV_MODE=true

# Frontend (Vite, Vercel hosting)
VITE_API_URL=http://localhost:8080/api

# CI/CD secrets (set in GitHub Repo → Settings → Secrets and variables → Actions, never in code)
# RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxx?key=yyy
# VERCEL_TOKEN=vercel-token-here
